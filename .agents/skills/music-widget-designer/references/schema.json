{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Music Widget v1",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "width": {
      "type": "integer",
      "minimum": 240,
      "maximum": 1024
    },
    "height": {
      "type": "integer",
      "minimum": 120,
      "maximum": 1024
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "image"
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1024
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1024
              },
              "w": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1024
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1024
              },
              "src": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)*\\.(?:png|ttf|otf)$",
                "maxLength": 160
              }
            },
            "required": [
              "type",
              "x",
              "y",
              "w",
              "h",
              "src"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "artwork"
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1024
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1024
              },
              "w": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1024
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1024
              },
              "fallback": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)*\\.(?:png|ttf|otf)$",
                "maxLength": 160
              }
            },
            "required": [
              "type",
              "x",
              "y",
              "w",
              "h",
              "fallback"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "text"
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1024
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1024
              },
              "w": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1024
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1024
              },
              "field": {
                "enum": [
                  "title",
                  "artist",
                  "album",
                  "player",
                  "status"
                ]
              },
              "size": {
                "type": "number",
                "minimum": 6,
                "maximum": 160
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "font": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)*\\.(?:png|ttf|otf)$",
                "maxLength": 160
              }
            },
            "required": [
              "type",
              "x",
              "y",
              "w",
              "h",
              "field",
              "size",
              "color",
              "font"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "icon"
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1024
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1024
              },
              "w": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1024
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1024
              },
              "action": {
                "enum": [
                  "previous",
                  "toggle",
                  "next",
                  "switch",
                  "settings"
                ]
              },
              "src": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)*\\.(?:png|ttf|otf)$",
                "maxLength": 160
              },
              "playingSrc": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)*\\.(?:png|ttf|otf)$",
                "maxLength": 160
              }
            },
            "required": [
              "type",
              "x",
              "y",
              "w",
              "h",
              "action",
              "src"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "touch": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1024
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1024
          },
          "w": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1024
          },
          "h": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1024
          },
          "action": {
            "enum": [
              "previous",
              "toggle",
              "next",
              "switch",
              "settings"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "x",
          "y",
          "w",
          "h",
          "action",
          "label"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "id",
    "name",
    "width",
    "height",
    "layers",
    "touch"
  ],
  "additionalProperties": false
}
